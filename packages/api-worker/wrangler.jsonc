{
    "name": "otc-api-worker-qualification",
    "main": "src/qualification.ts",
    "compatibility_date": "2026-10-20",
    "workers_dev": false,
    "send_metrics": false,
    "dev": { "ip": "127.0.0.1", "port": 8787 },
    "durable_objects": {
        "bindings": [{ "name": "LIMITS", "class_name": "RateLimit" }]
    },
    "migrations": [{ "tag": "limits-local", "new_sqlite_classes": ["RateLimit"] }],
    "r2_buckets": [
        { "binding": "RELEASES", "bucket_name": "otc-qualification" }
    ]
}

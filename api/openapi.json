{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenTideConstants existing SDK HTTP routes",
    "version": "1.0.0",
    "description": "Local Worker route contract. Responses use the existing SDK canonical runner serialization. This document does not claim a deployed or publicly available service."
  },
  "paths": {
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "summary": "This OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/stations": {
      "get": {
        "operationId": "stations",
        "summary": "SDK station listing, name search, near or bounding-box discovery",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "SDK name search. Without a search, near or bbox selection, return SDK stations."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Bounding box as west,south,east,north in degrees."
          }
        ],
        "responses": {
          "200": {
            "description": "Unchanged canonical SDK runner wire body. Attribution and release identity are HTTP headers.",
            "headers": {
              "Attribution": {
                "description": "Percent-encoded UTF-8 SDK attribution for the returned station selection; decode with decodeURIComponent.",
                "schema": {
                  "type": "string"
                }
              },
              "DATESTAMP": {
                "description": "The SDK release datestamp used for this response.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Existing SDK error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Existing Worker rate limit.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "limit"
                  ],
                  "properties": {
                    "limit": {
                      "type": "string",
                      "enum": [
                        "minute",
                        "day"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },

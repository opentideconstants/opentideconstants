            "schema": {
              "type": "string"
            },
            "description": "Inclusive prediction start; an ISO 8601 timestamp with offset."
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Prediction stop; an ISO 8601 timestamp with offset."
          },
          {
            "name": "set_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "datum",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Existing SDK datum selector, including mean_level, chart, lat and hat. Unavailable datums retain the SDK error."
          },
          {
            "name": "units",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "meters",
                "feet"
              ]
            },
            "description": "meters or feet. Omit to retain the canonical runner body without units/getter fields."
